<Window
    x:Class="Lesson4.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Lesson4"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Lesson4.ViewModel;assembly=Lesson4.ViewModel"
    Title="MainWindow"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
    mc:Ignorable="d">
    <Grid>
        <StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Result1}" />
                <TextBox Text="{Binding Number1}" />
                <Button Command="{Binding CalculateSum1}" Content="Сумма" />
                <Button Command="{Binding CancelSum1}" Content="Отмена" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Result2}" />
                <TextBox Text="{Binding Number2}" />
                <Button
                    Name="Button2"
                    Command="{Binding CalculateSum2}"
                    Content="Сумма" />
                <Button Command="{Binding CancelSum2}" Content="Отмена" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
