<Window
    x:Class="Lesson4.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Lesson4"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <StackPanel>
            <StackPanel>
                <TextBlock Name="Result1" Text="Результат: " />
                <TextBox x:Name="Number1" />
                <Button
                    Name="Button1"
                    Click="Button_Click1"
                    Content="Сумма" />
            </StackPanel>
            <StackPanel>
                <TextBlock Name="Result2" Text="Результат: " />
                <TextBox x:Name="Number2" />
                <Button
                    Name="Button2"
                    Click="Button_Click2"
                    Content="Сумма" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
